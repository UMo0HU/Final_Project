@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> SignInManager;

@if (SignInManager.IsSignedIn(User))
{
	<li class="nav-item">
		<a class="nav-link" asp-controller="User" asp-action="Profile"><i class="fas fa-heart"></i></a>
	</li>
	<li class="nav-item">
		<a class="nav-link" asp-controller="User" asp-action="Checkout"><i class="fas fa-cart-shopping"></i></a>
	</li>
	<li class="nav-item">
		<button class="nav-link user-toggler" onclick="userToggler()"><i class="fas fa-user"></i></button>
		<div class="user-toggler-list">
			<ul>
				<li><a asp-Controller="Order" asp-action="OrderList">My Orders</a></li>
				<li><a asp-Controller="User" asp-Action="AccountManage">Manage Account</a></li>
			</ul>
		</div>
	</li>
	<li class="nav-item">
		<a class="nav-link" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
	</li>
}
else
{
	<li class="nav-item">
		<a class="btn header-button" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
	</li>
}

