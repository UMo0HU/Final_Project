@using BookStore.Models; 
@model Book

<h2>Read Free Library Books Online!</h2>

<p>Search, explore, enjoy. Our digital library puts millions of books and articles at your fingertips. Join us today!</p>

<img src="/images/books.jpg" alt="Books Illustration" />

<h3>Popular</h3>

<div class="row">
        <div class="col-md-3">
            <div class="card">
                <img src="@Model.Img" class="card-img-top" alt="Book Image">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
				    <p class="card-text">@Model.Description</p>
                </div>
            </div>
        </div>
        @foreach(var review in Model.reviews) {
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@review.User.UserName</h5>
                    <p class="card-text">@review.Content</p>
                </div>
            </div>
        </div>
        }
</div>