@using Microsoft.AspNetCore.Identity;
@model ReviewViewModel
@inject SignInManager<User> SignInManager
@{
    ViewBag.Title = "Book Details";
    var Book = Model.Book;
    var bookCategories = ViewBag.BookCategories as List<Category>;
    var userReviewIds = ViewBag.UserReviewIds as List<int> ?? new List<int>();
    bool bookInWishlist = ViewBag.BookInWishlist;
}

<div class="container book-details">
    <div class="book-cover">
        <img src="~/book-images/@Book.Img" alt="@Book.Img">
    </div>
    <div class="book-info">
        <h1 class="book-title">@Book.Title</h1>
        <div class="rating">
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star-empty"><i class="far fa-star"></i></span>
            <span class="rating-value">4.0</span>
        </div>
        <p class="author"><strong>Auther:</strong> @Book.Author</p>
        <p class="category"><strong>Category:</strong> 
            @foreach (var category in bookCategories)
            {
                if (category == bookCategories.Last())
                {
                    <span>@category.Name.</span>
                }
                else {
                    <span>@category.Name, </span>
                }
            }
            </p>
        <div class="description">
            <p>@Book.Description</p>
        </div>
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="actions">
                <button class="read-button">Add to cart</button>
                <button id="wishlistButton" onclick="WishlistToggler(@Book.Id)" class="download-button @(bookInWishlist? "added" : "")"> @(bookInWishlist ? "Added to wishlist" : "Add to wishlist")</button>
            </div>
        }
        else {
            <h3 class="login-prompt">Please <a class="btn btn-primary" href="@Url.Action("Login", "Account")">login</a> to add this book to your wishlist/cart.</h3>
        }
    </div>
</div>

<hr />

<div id="reviwesContainer">
    @await Html.PartialAsync("_ReviewsPartial", new UserReviewsViewModel{
        reviews = Book.Reviews.ToList(),
        UserReviewsId = userReviewIds
    })
</div>
<div class="add-review">
    @if (!SignInManager.IsSignedIn(User))
    {
        <h3 class="login-prompt">Please login to add a review.</h3>
    }
    else
    {
    <h3>Add Comment </h3>
        <form id="reviewForm" method="post">
            <input type="hidden" asp-for="BookId" value="@Book.Id" />
            <h5 class="mb-2">Rating:</h5>
            <div class="form-group">
                <div class="star-rating animated-stars">
                    <input type="radio" id="star5" asp-for="Rating" value="5">
                    <label for="star5" class="fas fa-star"></label>
                    <input type="radio" id="star4" asp-for="Rating" value="4">
                    <label for="star4" class="fas fa-star"></label>
                    <input type="radio" id="star3" asp-for="Rating" value="3">
                    <label for="star3" class="fas fa-star"></label>
                    <input type="radio" id="star2" asp-for="Rating" value="2">
                    <label for="star2" class="fas fa-star"></label>
                    <input type="radio" id="star1" asp-for="Rating" value="1">
                    <label for="star1" class="fas fa-star"></label>
                </div>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Comment">Comments:</label>
                <textarea class="form-control" asp-for="Content" rows="4" required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    }

</div>

@section Styles {
    <link href="~/css/bookDetails.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        document.querySelectorAll('.star-rating:not(.readonly) label').forEach(star => {
            star.addEventListener('click', function() {
                this.style.transform = 'scale(1.2)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 200);
            });
        });
        function WishlistToggler(BookId) {
            const button = document.getElementById("wishlistButton");

            $.ajax({
                type: "POST",
                url: button.classList.contains("added")? '@Url.Action("RemoveFromWishlist", "Book")' : '@Url.Action("AddToWishlist", "Book")',
                data: { id: BookId },
                success: function () {
                    if (button.classList.contains("added")) {
                        button.classList.remove("added");
                        button.innerHTML = "Add to wishlist";
                    } else {
                        button.classList.add("added");
                        button.innerHTML = "Added to wishlist";
                    }
                    Swal.fire(button.classList.contains("added")? "Book Added To Wishlist." : "Book Removed From Wishlist.");
                },
                error: function () {
                    Swal.fire({
                      icon: "error",
                      title: "Oops...",
                      text: "Something went wrong!",
                    });
                }
            });
        }

        function DeleteReview(reviewId, bookId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteReview", "Review")',
                data: {id: reviewId},
                success: function () {
                    $("#reviwesContainer").load('@Url.Action("GetReviews", "Review")?bookId=' + bookId);
                    Swal.fire({
                        title: "Good job!",
                        text: "Review Deleted Successfully!",
                        icon: "success"
                    });
                },
                error: function () {
                    Swal.fire({
                      icon: "error",
                      title: "Oops...",
                      text: "Something went wrong!",
                    });
                }
            });
        }

        $("#reviewForm").submit(function (e) {
            e.preventDefault();
            const formData = {
                BookId: $('input[name="BookId"]').val(),
                Rating: $('input[name="Rating"]:checked').val(),
                Content: $('textarea[name="Content"]').val(),
            };
            $.ajax({
                type: "POST",
                url: '@Url.Action("AddReview", "Review")',
                data: formData,
                success: function () {
                    $("#reviwesContainer").load('@Url.Action("GetReviews", "Review")?bookId=@Book.Id');
                    Swal.fire({
                        title: "Good job!",
                        text: "Review Created Successfully!",
                        icon: "success"
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: "Something went wrong!",
                    });
                }
            });
        });
    </script>
}

