@using BookStore.Models; 
@model Book

@{
    ViewBag.Title = "Book Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container book-details">
    <div class="book-cover">
        <img src="~/book-images/@Model.Img" alt="@Model.Img">
    </div>
    <div class="book-info">
        <h1 class="book-title">I Don't Love You Anymore</h1>
        <div class="rating">
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star"><i class="fas fa-star"></i></span>
            <span class="star-empty"><i class="far fa-star"></i></span>
            <span class="rating-value">4.0</span>
        </div>
        <p class="author">Auther: @Model.Author</p>
        <p class="category">Category: 
            @foreach (var bookCategory in Model.Book_Categories)
            {
                <span class="category-item">@bookCategory.Category.Name</span>
            }
        </p>
        <div class="description">
            <p>@Model.Description</p>
        </div>
        <div class="actions">
            <button class="read-button">Read</button>
            <button class="download-button">Download</button>
        </div>
        <div class="wishlist">
            <a href="#"><i class="far fa-heart"></i> Add To WishList</a>
        </div>
        <div class="share">
            <span>Share</span>
            <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
            <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
            <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/bookDetails.css" rel="stylesheet" />
}