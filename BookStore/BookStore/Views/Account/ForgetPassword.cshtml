@model ForgetPasswordViewModel
@{
    ViewBag.Title = "Forget Password";
    Layout = "_LoginLayout";
}

<div class="login-form">
    @if(Model?.EmailSent == true) {
        <div class="alert alert-success" role="alert">
            We Sent Reset Password Link To Your Email.
        </div>
    }
    else {
        <form asp-controller="Account" asp-action="ForgetPassword" method="post">
            <div class="form-icon">
                <span><img draggable="false" src="/images/UserLogo.png" alt="Alternate Text" /></span>
                <h3 class="text-center">Forget Password</h3>
            </div>
            <div class="d-flex flex-column justify-content-center" style="height: 55%;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email">Email : </label>
                    <div class="input-box">
                        <input class="form-control item" asp-for="Email" placeholder="Enter The Email">
                        <img draggable="false" class="input-icon" src="/images/EmailLogo.png" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>


                <div class="form-group text-center">
                    <button type="submit" class="btn btn-block login-btn w-100">Submit</button>
                </div>

                <div class="form-group text-center">
                    <a asp-controller="Account" asp-action="Login" class="forget-password-link">Login</a>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
