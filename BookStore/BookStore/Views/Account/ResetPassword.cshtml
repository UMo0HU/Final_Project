@model ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    Layout = "_LoginLayout";
}

<div class="login-form">
    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <div class="form-icon">
            <span><img draggable="false" src="/images/UserLogo.png" alt="Alternate Text" /></span>
            <h3 class="text-center">Reset Password</h3>
        </div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div class="d-flex flex-column justify-content-center" style="height: 75%;">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <div class="input-box">
                    <input class="form-control item" asp-for="Password" placeholder="********">
                    <img draggable="false" class="input-icon" src="/images/PasswordLogo.png" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="input-box">
                    <input class="form-control item" asp-for="ConfirmPassword" placeholder="********">
                    <img draggable="false" class="input-icon" src="/images/PasswordLogo.png" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-group text-center">
                <button type="submit" class="btn btn-block login-btn w-100">Login</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}