@using BookStore.ViewModels;
@model RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "_AccountLayout";
}
<div class="row">
    <div class="col-3 d-flex flex-column justify-content-center align-items-center login-redirect-section">
        <h2 class="card-title">Welcome !</h2>
        <p class="card-text">To keep connected with us please login with your personal info, or register if don’t have an account.</p>
        <a asp-controller="Account" asp-action="Login" class="w-75 login-redirect-btn">Login</a>
    </div>
    <div class="col registration-form">
        <form asp-controller="Account" asp-action="Register" method="post">
            <h2 class="text-center">Create Account</h2>
            <div class="social-icons">
                <a href="#"><img src="/images/FacebookCircled.svg" /></a>
                <a href="#"><img src="/images/Google.svg" /></a>
                <a href="#"><img src="/images/LinkedInCircled.svg" /></a>
            </div>
            <p>or use email for registration</p>
            <div class="input-box">
                <img draggable="false" class="input-icon" src="/images/User.svg" />
                <input class="form-control item" asp-for="Name" placeholder="Name">
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
            <div class="input-box">
                <img draggable="false" class="input-icon" src="/images/EmailLogo.png" />
                <input class="form-control item" asp-for="Email" placeholder="Email">
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
            <div class="input-box">
                <img draggable="false" class="input-icon" src="/images/Password.svg" />
                <input class="form-control item" asp-for="Password" placeholder="Password">
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="input-box">
                <img draggable="false" class="input-icon" src="/images/Password.svg" />
                <input class="form-control item" asp-for="ConfirmPassword" placeholder="Confirm Password">
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <div class="form-group text-center">
                <button type="submit" class="btn btn-block create-account">Sign Up</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}