@model LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "_LoginLayout";
}

<div class="login-form">
    <form asp-controller="Account" asp-action="Login" method="post">
        <div class="form-icon">
            <span><img draggable="false" src="/images/UserLogo.png" alt="Alternate Text" /></span>
            <h2 class="text-center">Log In</h2>
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Email">Email : </label>
            <div class="input-box">
                <input class="form-control item" asp-for="Email" placeholder="Enter The Email">
                <img draggable="false" class="input-icon" src="/images/EmailLogo.png" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <div class="input-box">
                <input class="form-control item" asp-for="Password" placeholder="********">
                <img draggable="false" class="input-icon" src="/images/PasswordLogo.png" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-block login-btn w-100">Login</button>
        </div>

        <div class="form-group text-center">
            <p>Don't have an account? <a asp-controller="Account" asp-action="Register" class="link-info register-page-link">Sign up</a></p>
        </div>
        <div class="form-group text-center">
            <a asp-controller="Account" asp-action="ForgetPassword" class="forget-password-link">Forgot Password</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}