@model AccountManageViewModel
@{
    ViewBag.Title = "User Info";
}
<div class="d-flex flex-row manage-content">
    @await Html.PartialAsync("_SideNavPartial")
    <div class="page-content m-4">
        @if (Model?.ImageChanged == true)
        {
            <div class="alert alert-success" role="alert">
                Profile Picture Changed Successfully.
            </div>
        }
        <h1>User Info</h1>
        <form asp-controller="User" asp-action="AccountManage" method="post" enctype="multipart/form-data">
            <div class="d-flex flex-column align-items-center">
                <div class="mb-3">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input type="file" accept="image/*" class="form-control" asp-for="ProfilePicture">
                    <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                </div>
                <img src="" class="image-preview"/>
            </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn w-75 fs-5" style="background-color: #674636; color: #FFF8E8;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link href="~/css//Manage.css" rel="stylesheet"/>
}

@section Scripts {
    <script>
        const imageInput = document.querySelector("input[type='file']");
        const imagePreview = document.querySelector(".image-preview");

        imageInput.addEventListener("change", function (event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imagePreview.src = e.target.result;
                        imagePreview.style = `
                        width: 100px;
                        height: 100px;
                        border-radius: 50%;
                        padding: 5px;
                        border: 1px solid #674636;
                        `;
                    };
                    reader.readAsDataURL(file);
                }
            });
    </script>


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}