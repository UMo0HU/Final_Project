@model ChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
}

<div class="d-flex flex-row manage-content">
    @await Html.PartialAsync("_SideNavPartial")
    <div class="page-content m-4">
        <h1>Change Password</h1>
        @if(Model?.PasswordChanged == true) {
            <div class="alert alert-success" role="alert">
                Password Changed Successfully.
            </div>
        }
        <form asp-Controller="User" asp-action="ChangePassword" method="post">
            <span asp-validation-summary="ModelOnly" class="text-danger"></span>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input class="form-control" asp-for="CurrentPassword">
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input class="form-control" asp-for="NewPassword">
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input class="form-control" asp-for="ConfirmNewPassword">
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn w-75 fs-5" style="background-color: #674636; color: #FFF8E8;">Change Password</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link href="~/css//Manage.css" rel="stylesheet" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}