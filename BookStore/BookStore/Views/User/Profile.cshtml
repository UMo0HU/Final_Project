@{
    ViewBag.Title = "Profile";
    Layout = "_Layout";
}
    <!-- Profile Section -->
    <div class="container profile-section">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSyQj1a4i_d_Uw51VxX9FMapTeFxh4v-f_POg&s" alt="Profile Image" class="profile-img">
        <h2 class="profile-name">Anas Habib</h2>
        <h4 class="profile-books">23 Books</h4>
        <p class="profile-bio">Lorem ipsum dolor sit amet consectetur.</p>
        <div class="social-icons">
            <a href="#" class="text-primary"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="text-info"><i class="fab fa-twitter"></i></a>
            <a href="#" class="text-danger"><i class="fab fa-instagram"></i></a>
        </div>
    </div>
    <!-- Books Section -->
    <div class="container books-section">
        <h3>My Books</h3>
        <div class="row justify-content-center">
            <div class="col-6 col-sm-4 col-md-3 book-card">
                <img src="https://images.penguinrandomhouse.com/cover/9780593422182" alt="Book 1">
                <i class="fas fa-heart heart-icon" onclick="toggleFavorite(this)"></i>
            </div>
            <div class="col-6 col-sm-4 col-md-3 book-card">
                <img src="https://bukovero.com/wp-content/uploads/2016/07/Harry_Potter_and_the_Cursed_Child_Special_Rehearsal_Edition_Book_Cover.jpg" alt="Book 2">
                <i class="fas fa-heart heart-icon" onclick="toggleFavorite(this)"></i>
            </div>
            <div class="col-6 col-sm-4 col-md-3 book-card">
                <img src="https://blog-cdn.reedsy.com/directories/gallery/248/large_65b0ae90317f7596d6f95bfdd6131398.jpg" alt="Book 3">
                <i class="fas fa-heart heart-icon" onclick="toggleFavorite(this)"></i>
        </div>
        </div>
        </div>
        <script>
        function toggleFavorite(heartIcon) {
            heartIcon.classList.toggle('favorited');
        }
    </script>
