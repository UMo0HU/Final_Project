@model List<Wishlist>
@{
    ViewBag.Title = "Profile";
    Layout = "_Layout";
}
<!-- Profile Section -->
<div class="container profile-section">
    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSyQj1a4i_d_Uw51VxX9FMapTeFxh4v-f_POg&s" alt="Profile Image" class="profile-img">
    <h2 class="profile-name">Anas Habib</h2>
    <h4 class="profile-books">23 Books</h4>
    <p class="profile-bio">Lorem ipsum dolor sit amet consectetur.</p>
    <div class="social-icons">
        <a href="#" class="text-primary"><i class="fab fa-facebook-f"></i></a>
        <a href="#" class="text-info"><i class="fab fa-twitter"></i></a>
        <a href="#" class="text-danger"><i class="fab fa-instagram"></i></a>
    </div>
</div>
<!-- Books Section -->
<div class="container books-section">
    <h3>My Books</h3>
    <div class="cards">
        <div class="cards-card">
            <div class="card-img"><img src="~/images/image (3).png" alt=""></div>
            <div class="card-icon book-details-page-wishlist"><i class="fa-regular fa-heart"></i></div>
        </div>
        <div class="cards-card">
            <div class="card-img"><img src="~/images/image (5).png" alt=""></div>
            <div class="card-icon book-details-page-wishlist"><i class="fa-regular fa-heart"></i></div>
        </div>
        <div class="cards-card">
            <div class="card-img "><img src="~/images/image (4).png" alt=""></div>
            <div class="card-icon book-details-page-wishlist"><i class="fa-regular fa-heart"></i></div>
        </div>
        <div class="cards-card">
            <div class="card-img"><img src="~/images/Group 104.png" alt=""></div>
            <div class="card-icon book-details-page-wishlist"><i class="fa-regular fa-heart"></i></div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/profile.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/heartToggler.js"></script>
}