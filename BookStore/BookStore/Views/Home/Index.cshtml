@model List<Book>

@{
    ViewData["Title"] = "Home Page";
    var wishlistBookIds = ViewBag.WishlistBookIds as List<int> ?? new List<int>();
}


<div id="home">
    <div class="home-info">
        <h2 class="home-title">read free library books online !</h2>
        <div class="home-description">search, explore, enjoy. Our digital library puts millions of books and articles at your fingertips. Join us today!</div>
    </div>
    <div class="home-image"><img src="~/images/6046205542424233186.jpg" alt=""></div>
</div>
<div class="popular">
    <p class="main-line">_________________________________________________________________________________________________</p>
    <h3 class="popular-title">popular</h3>
    <div class="cards">
            @foreach(var book in Model) {
                <div class="cards-card">
                    @await Html.PartialAsync("_WishlistButtonPartial", new WishlistButtonViewModel
                    {
                        BookId = book.Id,
                        IsInWishlist = wishlistBookIds.Contains(book.Id)
                    })
                    <a asp-controller="Book" asp-action="Details" asp-route-Id="@book.Id">
                        <div class="card-img"><img src="~/book-images/@book.Img" width="200" height="300" alt=""></div>
                    </a>
                </div>
            }
        </div>
    </div>

@section Styles {
    <link href="~/css/home.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        const addToWishlistUrl = '@Url.Action("AddToWishlist", "Book")';
        const removeFromWishlistUrl = '@Url.Action("RemoveFromWishlist", "Book")';
    </script>
    <script src="~/js/heartToggler.js"></script>
}