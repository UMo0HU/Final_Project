@model BookViewModel
@{
    ViewData["Title"] = "Books";
    Layout = "_AdminLayout";
    var Books = ViewBag.Books as List<Book>;
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Books</h2>
    <a asp-action="AddBook" class="btn btn-view">
        <i class="fa fa-book"></i> Add Book
    </a>
</div>

@foreach (var book in Books.Select((value, index) => new { Index = index + 1, Book = value }))
{
    <div class="book-card">
        <div class="book-header">
            <h2 class="book-title">@book.Index. @book.Book.Title</h2>
            <span class="book-price">Price: $@book.Book.Price.ToString("0.00")</span>
        </div>

        <p class="book-description">
            @if (!string.IsNullOrEmpty(book.Book.Description))
            {
                if (book.Book.Description.Length > 150)
                {
                    @(book.Book.Description.Substring(0, 150) + "...")
                }
                else
                {
                    @book.Book.Description
                }
            }
            else
            {
                <span>No description available.</span>
            }
        </p>

        <div class="book-details">
            <div class="book-cover">
                @if (!string.IsNullOrEmpty(book.Book.Img))
                {
                    <img src="~/book-images/@book.Book.Img" alt="@book.Book.Title" class="cover-image">
                }
                else
                {
                    <div class="cover-text">
                        <strong>@book.Book.Title.Split(' ').First().ToUpper()</strong><br>
                        @string.Join(" ", book.Book.Title.Split(' ').Skip(1)).ToUpper()<br>
                        <em>@book.Book.Author</em>
                    </div>
                }
            </div>
            <div class="book-meta">
                <div><strong>Categories:</strong> @string.Join(", ", book.Book.Book_Categories?.Select(c => c.Category.Name))</div>
                <div><strong>Stock:</strong> @book.Book.Stock</div>
                <div class="book-actions">
                    <a asp-controller="Admin" asp-action="EditBook" asp-route-id="@book.Book.Id" class="btn btn-edit">
                        <i class="fa fa-pencil"></i> Edit
                    </a>
                    <a asp-controller="Admin" asp-action="DeleteBook" asp-route-id="@book.Book.Id" onclick="return confirm('Are you sure you want to delete this book?')" class="btn btn-delete">
                        <i class="fa fa-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/viewBooks.css" rel="stylesheet"/>
}
