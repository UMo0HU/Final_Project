@{
    ViewData["Title"] = "Admin Home";
    Layout = "_AdminLayout";
}

<div class="content">
    <section id="overview" class="mb-5">
        <h1 class="mb-4">Dashboard</h1>
        <div class="row">
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Total Books</h3>
                    <p id="totalBooks" class="fs-2">0</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Orders</h3>
                    <p id="totalOrders" class="fs-2">0</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Sales</h3>
                    <p id="totalSales" class="fs-2">$0</p>
                </div>
            </div>
        </div>
    </section>
</div>