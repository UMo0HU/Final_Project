@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Home";
    Layout = "_AdminLayout";
}

<div class="content">
    <section id="overview" class="mb-5">
        <h1 class="mb-4">Dashboard</h1>
        <div class="row">
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Total Books</h3>
                    <p id="totalBooks" class="fs-2">@Model.TotalBooks</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Users</h3>
                    <p id="totalUsers" class="fs-2">@Model.Users</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Sales</h3>
                    <p id="totalSales" class="fs-2">$@Model.Sales</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Total Orders</h3>
                    <p id="totalOrders" class="fs-2">@Model.TotalOrders</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Canceled Orders</h3>
                    <p id="canceledOrders" class="fs-2">@Model.CanceledOrders</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Pending Orders</h3>
                    <p id="pendingOrders" class="fs-2">@Model.PendingOrders</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Delivered Orders</h3>
                    <p id="deliveredOrders" class="fs-2">@Model.DeliveredOrders</p>
                </div>
            </div>
        </div>
    </section>
</div>