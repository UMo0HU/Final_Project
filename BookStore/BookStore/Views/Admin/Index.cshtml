@{
    ViewData["Title"] = "Admin Home Page";
}

<div class="sidebar">
    <h2 class="mb-5">Admin Dashboard</h2>
    <a href="#overview">Overview</a>
    <a href="#books">Books Management</a>
    <a href="#orders">Orders Management</a>
</div>

<div class="content">

    <section id="overview" class="mb-5">
        <h1 class="mb-4">Overview</h1>
        <div class="row">
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Total Books</h3>
                    <p id="totalBooks" class="fs-2">0</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Orders</h3>
                    <p id="totalOrders" class="fs-2">0</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 mb-3">
                    <h3>Sales</h3>
                    <p id="totalSales" class="fs-2">$0</p>
                </div>
            </div>
        </div>
    </section>


    <section id="books" class="mb-5">
        <h2 class="mb-4">Books Management</h2>
        <div class="card p-4 mb-4">
            <h3>Add New Book</h3>
            <form id="addBookForm">
                <div class="mb-3">
                    <input type="text" class="form-control" id="bookTitle" placeholder="Book Title" required>
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" id="bookAuthor" placeholder="Author" required>
                </div>
                <div class="mb-3">
                    <input type="number" class="form-control" id="bookPrice" placeholder="Price" required>
                </div>
                <div class="mb-3">
                    <input type="number" class="form-control" id="bookStock" placeholder="Stock" required>
                </div>
                <button type="submit" class="btn btn-custom">Add Book</button>
            </form>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="booksTableBody"></tbody>
        </table>
    </section>


    <section id="orders">
        <h2 class="mb-4">Orders Management</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Book</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody"></tbody>
        </table>
    </section>
</div>

@section Scripts {
<script>
    // Sample data
    let books = [
      { id: 1, title: "Book 1", author: "Author 1", price: 100, stock: 50 },
      { id: 2, title: "Book 2", author: "Author 2", price: 150, stock: 30 },
    ];

    let orders = [
      { id: 1, customer: "Customer 1", book: "Book 1", status: "In Delivery" },
      { id: 2, customer: "Customer 2", book: "Book 2", status: "Completed" },
    ];

    
    function updateOverview() {
      document.getElementById("totalBooks").textContent = books.length;
      document.getElementById("totalOrders").textContent = orders.length;
      document.getElementById("totalSales").textContent = `$${orders.length * 100}`;
    }

   
    function renderBooks() {
      const booksTableBody = document.getElementById("booksTableBody");
      booksTableBody.innerHTML = "";
      books.forEach(book => {
        booksTableBody.innerHTML += `
          <tr>
            <td>${book.title}</td>
            <td>${book.author}</td>
            <td>$${book.price}</td>
            <td>${book.stock}</td>
            <td>
              <button class="btn btn-delete btn-sm" onclick="deleteBook(${book.id})">Delete</button>
            </td>
          </tr>
        `;
      });
      updateOverview();
    }

    function renderOrders() {
      const ordersTableBody = document.getElementById("ordersTableBody");
      ordersTableBody.innerHTML = "";
      orders.forEach(order => {
        ordersTableBody.innerHTML += `
          <tr>
            <td>${order.id}</td>
            <td>${order.customer}</td>
            <td>${order.book}</td>
            <td>${order.status}</td>
          </tr>
        `;
      });
    }


    document.getElementById("addBookForm").addEventListener("submit", function(e) {
        e.preventDefault();
        const newBook = {
        id: books.length + 1,
        title: document.getElementById("bookTitle").value,
        author: document.getElementById("bookAuthor").value,
        price: parseFloat(document.getElementById("bookPrice").value),
        stock: parseInt(document.getElementById("bookStock").value),
        };
        books.push(newBook);
        renderBooks();
        this.reset();
    });

    function deleteBook(id) {
        books = books.filter(book => book.id !== id);
        renderBooks();
    }


    renderBooks();
    renderOrders();
</script>

}
@section Styles {
    <style>
        :root {
            --body-color: #FFF8E8;
            --first-color: #674636;
            --second-color: #F7EED3;
            --buttons-color: #AAB396;
        }

        body {
            background-color: var(--body-color);
            font-family: 'Roboto', sans-serif;
            line-height: 1.6;
            color: #333;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            color: var(--first-color);
        }

        .sidebar {
            background-color: var(--first-color);
            color: white;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            padding: 20px;
            font-family: 'Roboto', sans-serif;
        }

            .sidebar h2 {
                font-size: 1.75rem;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .sidebar a {
                color: white;
                text-decoration: none;
                display: block;
                margin-bottom: 15px;
                font-size: 1.1rem;
                font-weight: 500;
                transition: color 0.3s ease;
            }

                .sidebar a:hover {
                    color: var(--second-color);
                }

        .content {
            margin-left: 270px;
            padding: 30px;
        }

        .card {
            background-color: var(--second-color);
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

            .card h3 {
                font-size: 1.25rem;
                font-weight: 600;
            }

        .btn-custom {
            background-color: var(--buttons-color);
            border: none;
            color: white;
            font-family: 'Roboto', sans-serif;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

            .btn-custom:hover {
                background-color: #8a9279;
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
            font-family: 'Roboto', sans-serif;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 5px;
        }

            .btn-delete:hover {
                background-color: #c82333;
            }

        table {
            background-color: var(--second-color);
            border-radius: 10px;
            font-family: 'Roboto', sans-serif;
        }

        th {
            background-color: var(--first-color);
            color: white;
            font-weight: 500;
            font-size: 1rem;
            padding: 12px;
        }

        td {
            font-size: 0.95rem;
            padding: 12px;
            vertical-align: middle;
        }

        .form-control {
            font-family: 'Roboto', sans-serif;
            font-size: 0.95rem;
            border-radius: 5px;
        }

            .form-control::placeholder {
                color: #999;
                font-weight: 400;
            }
        </style>
}