@model Category
@{
	ViewBag.Title = "Categories";
	Layout = "_AdminLayout";
}

<form asp-controller="Admin" asp-action="EditCategory" asp-route-Id="@Model.Id" method="post">
	<div class="form-group">
		<label asp-for="Name"></label>
		<input type="text" class="form-control" asp-for="Name" placeholder="Enter name">
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Description"></label>
		<textarea class="form-control" asp-for="Description" placeholder="Enter description"></textarea>
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>
	<input type="submit" class="btn btn-primary" value="Edit Book Category">
</form>
