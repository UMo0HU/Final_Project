@model List<Category>
@{
    ViewBag.Title = "Categories";
    var books = ViewBag.Books as List<Book>;
}
<div class="container-fluid min-vh-100">
    <div class="row">
            <div class="col-md-3 col-lg-2  p-0 sticky-top vh-100">
            <div class="p-3 border-bottom border-secondary">
                <h4 class="m-0">Categories</h4>
            </div>

            <div class="p-3">
                <div class="input-group">
                    <input type="text" id="search" class="form-control" placeholder="Search...">
                    <button class="btn btn-dark" onclick="searchBook()"><i class="fas fa-search"></i></button>
                </div>
            </div>

            <div class="nav flex-column">
                @foreach (var category in Model)
                {
                    <a href="#" class="py-2 px-3 border-bottom border-secondary text-secondary">@category.Name</a>
                }
            </div>
        </div>

        <div class="col-md-9 col-lg-10 p-4">
            <div class="d-flex justify-content-between mb-4">
                <h2 class="m-0">Books</h2>
                <select class="form-select w-auto">
                    <option>Sort by</option>
                    <option>Popularity</option>
                    <option>Newest</option>
                </select>
            </div>

            <div class="row g-4">
                <div class="d-flex">
                @foreach (var book in books)
                {
                    <div class="card me-2">
                        <div class="card-icon book-details-page-wishlist"><i class="fa-regular fa-heart"></i></div>
                        <a asp-controller="Book" asp-action="Details" asp-route-Id="@book.Id">
                            <div class="img-thumbnail"><img src="~/book-images/@book.Img" width="250px" height="250px" alt=""></div>
                            <div class="card-body">
                                <h6 class="card-title text-truncate">@book.Title</h6>
                                <p class="card-text small text-muted">@book.Author</p>
                            </div>
                        </a>
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/categories.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        function searchBook() {
            const searchInput = document.getElementById('search');
            const searchTerm = searchInput.value.toLowerCase();
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                const title = card.querySelector('.card-title').textContent.toLowerCase();
                const author = card.querySelector('.card-text').textContent.toLowerCase();
                if (title.includes(searchTerm) || author.includes(searchTerm)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
    <script src="~/js/heartToggler.js"></script>
}