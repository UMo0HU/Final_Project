@model List<Category>
@{
    ViewBag.Title = "Categories";
    var books = ViewBag.Books as List<Book>;
    var wishlistBookIds = ViewBag.WishlistBookIds as List<int> ?? new List<int>();
    var cartBookIds = ViewBag.CartBookIds as List<int> ?? new List<int>();
}
<div class="inner-container">
    <div class="aside-content">
        <h2 class="aside-h2">Categories</h2>

        <ul class="aside-ul">
        @foreach(var category in Model) {
                <li><button class="aside-ul-categories" onclick="categorySearch(@category.Id)">@category.Name</button></li>
        }
        </ul>
    </div>
    <div class="main">
        <div class="main-top">
            <h2 class="main-h2">Books</h2>
        </div>
        <div class="cards">
            @await Html.PartialAsync("_LoadBooksPartial", new ShowBooksViewModel{
                books = books,
                UserCart = cartBookIds,
                UserWishlist = wishlistBookIds
            })
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/categories.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        function categorySearch(id) {
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetBooksByCategory", "Category")',
                data: {categoryId: id},
                success: function (result) {
                    $(".cards").html(result);
                },
                error: function () {
                    Swal.fire({
                      icon: "error",
                      title: "Oops...",
                      text: "Something went wrong!",
                    });
                }
            });
        }
    </script>
}