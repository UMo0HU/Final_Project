@model Order

@{
    ViewBag.Title = "Order Tracking";
    var orderitems = Model.OrderItems;
}



<div class="header">
    <h1>My Orders</h1>
</div>

<div class="container">
    <h2>Track Your Orders</h2>

    <div class="order-card">
        <div class="order-title">@Model.User</div>
        <p><strong>Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Status:</strong> <span class="status">@Model.Status</span></p>
        @foreach (var orderItem in orderitems)
        {
            <p>@orderItem.Book.Title</p>
        }
    </div>

</div>

@section Styles {
    <link href="~/css/userOrder.css" rel="stylesheet"/>
}