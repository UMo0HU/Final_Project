@{
    ViewData["Title"] = "Cancel Payment";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="message-box _fail">
            <i class="fa-solid fa-circle-xmark"></i>
            <h2> payment was Canceled </h2>
            <p>You will be redirected to the home page in 5 seconds...</p>
        </div>
    </div>
</div>


@section Styles {
    <style>
        ._fail {
            box-shadow: 0 15px 25px #00000019;
            padding: 45px;
            width: 100%;
            text-align: center;
            margin: 40px auto;
            border-bottom: solid 4px #ff1111;
        }

        ._fail i {
            font-size: 55px;
            color: #ff1111;
        }

        ._fail h2 {
            margin-bottom: 12px;
            font-size: 40px;
            font-weight: 500;
            line-height: 1.2;
            margin-top: 10px;
        }

        ._fail p {
            margin-bottom: 0px;
            font-size: 18px;
            color: #495057;
            font-weight: 500;
        }
    </style>
}

@section Scripts {
    <script>
        const redirectParagraph = document.querySelector(".message-box p");
        var counter = 5;

        setInterval(function () {
            if(counter == 1) {
                window.location.href = "/";
            }
            redirectParagraph.innerHTML = `You will be redirected to the home page in ${--counter} seconds...`;
        }, 1000)
    </script>
}